# ==========================================
# MediCore Monorepo — Single Source of Truth
# Copy to `.env` at repo root. Do not duplicate in apps/*.
# ==========================================

# Database
POSTGRES_DB=hospital
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432

# API (Spring modular monolith in apps/api)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hospital
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SERVER_PORT=8080
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Web admin (apps/web-admin)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true
PORT=3000

# Mobile (apps/mobile) — override at build/run time if needed
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080/api/v1
API_BASE_URL=http://localhost:8080/api/v1
