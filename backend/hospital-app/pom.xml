<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.mahesh</groupId>
		<artifactId>hospitalManagement</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>hospital-app</artifactId>
	<name>hospital-app</name>
	<description>Executable Spring Boot Application Runner for MediCore ERP</description>

	<dependencies>
		<dependency>
			<groupId>com.mahesh</groupId>
			<artifactId>hospital-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mahesh</groupId>
			<artifactId>hospital-patient</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mahesh</groupId>
			<artifactId>hospital-opd</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mahesh</groupId>
			<artifactId>hospital-billing</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mahesh</groupId>
			<artifactId>hospital-reception</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.mahesh</groupId>
			<artifactId>hospital-nurse</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.mahesh.hospitalManagement.HospitalManagementApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
